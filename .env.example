# === Database ===
# PostgreSQL connection string
# Contoh lokal: postgresql://postgres:postgres@localhost:5432/cashflow
# Contoh Supabase: postgresql://postgres.xxxxx:PASSWORD@aws-x-xx-southeast-x.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashflow

# === Auth ===
# Secret key untuk JWT (WAJIB diganti di production!)
JWT_SECRET=ganti_dengan_secret_key_yang_aman
JWT_EXPIRES_IN=24h

# === App ===
NEXT_PUBLIC_APP_NAME=Cashflow
